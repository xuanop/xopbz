            container.Position = UDim2.new(0.05, 0, 0.2, 0)
            container.BackgroundTransparency = 1
            container.CanvasSize = UDim2.new(0, 0, 0, 0)
            container.AutomaticCanvasSize = Enum.AutomaticSize.None
            container.ScrollBarThickness = 4
            container.BorderSizePixel = 0
            container.Visible = false
            contentContainers[name] = container

            local layout = Instance.new("UIListLayout", container)
            layout.Padding = UDim.new(0, 8)
            layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        end

        for i, name in ipairs(tabs) do
            local btn = Instance.new("TextButton", tabFrame)
            btn.Size = UDim2.new(0, 120, 1, 0)
            btn.Text = name
            btn.BackgroundColor3 = Color3.fromRGB(40,40,60)
            btn.BackgroundTransparency = 0.3
            btn.TextColor3 = Color3.new(1,1,1)
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 16
            btn.LayoutOrder = i
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

            btn.MouseButton1Click:Connect(function()
                for _, b in pairs(tabButtons) do
                    b.BackgroundTransparency = 0.5
                    b.TextColor3 = Color3.fromRGB(180,180,180)
                end
                btn.BackgroundTransparency = 0.1
                btn.TextColor3 = Color3.new(1,1,1)
                for n, container in pairs(contentContainers) do
                    container.Visible = (n == name)
                end
            end)
            tabButtons[name] = btn
        end

        -- Página Principal
        local mainCont = contentContainers["Principal"]
        local bhopBtn = createButtonSafe(mainCont, "Bhop: "..(bhopEnabled and "Ativado ✅" or "Desativado ❌"), function(btn) toggleBhop(btn) end)
        bhopBtn.BackgroundTransparency = bhopEnabled and 0.5 or 0.85

        local infiniteJumpBtn = createButtonSafe(mainCont, "🦘 Pulo Infinito: "..(infiniteJumpEnabled and "Ativado ✅" or "Desativado ❌"), function(btn) toggleInfiniteJump(btn) end, Color3.fromRGB(150,100,200))
        infiniteJumpBtn.BackgroundTransparency = infiniteJumpEnabled and 0.5 or 0.85

        createButtonSafe(mainCont, "⏱️ Controle de Tempo", function() createTimeControlWindow() end, Color3.fromRGB(100,150,200))

        pcall(function()
            local gravitySlider = createSlider(mainCont, "Gravidade", {0, 1000}, 1, "", 50, function(value) workspace.Gravity = value end)
            if gravitySlider then
                createButtonSafe(mainCont, "🔄 Redefinir Gravidade", function() workspace.Gravity = 50; gravitySlider:Set(50); showNotice("⚖️ Gravidade redefinida para 50", true) end, Color3.fromRGB(150,150,100))
            else
                local gravBox = Instance.new("TextBox", mainCont)
                gravBox.Size = UDim2.new(0.95, 0, 0, 35)
                gravBox.PlaceholderText = "Digite o valor da gravidade (0-1000)"
                gravBox.Text = "50"
                gravBox.BackgroundColor3 = Color3.fromRGB(30,30,40)
                gravBox.TextColor3 = Color3.new(1,1,1)
                Instance.new("UICorner", gravBox)
                createButtonSafe(mainCont, "Definir Gravidade", function()
                    local val = tonumber(gravBox.Text)
                    if val then workspace.Gravity = clamp(val, 0, 1000); showNotice("Gravidade definida para " .. val, true) end
                end, Color3.fromRGB(70,120,70))
                showNotice("⚠️ Falha ao criar slider, usando caixa de texto", true)
            end
        end)

        local antiAfkBtn = createButtonSafe(mainCont, "🛡️ Anti-AFK: " .. (antiAfkEnabled and "Ativado ✅" or "Desativado ❌"), function(btn) toggleAntiAFK(btn) end, Color3.fromRGB(100,100,150))
        antiAfkBtn.BackgroundTransparency = antiAfkEnabled and 0.5 or 0.85

        local playerEspBtn = createButtonSafe(mainCont, "👤 ESP Jogadores: " .. (playerEspEnabled and "Ativado ✅" or "Desativado ❌"), function(btn) togglePlayerEsp(btn) end, Color3.fromRGB(100,150,100))
        playerEspBtn.BackgroundTransparency = playerEspEnabled and 0.5 or 0.85

        local botEspBtn = createButtonSafe(mainCont, "🤖 ESP Bots: " .. (botEspEnabled and "Ativado ✅" or "Desativado ❌"), function(btn) toggleBotEsp(btn) end, Color3.fromRGB(200,100,100))
        botEspBtn.BackgroundTransparency = botEspEnabled and 0.5 or 0.85

        local distanceEspBtn = createButtonSafe(mainCont, "📏 Mostrar Distância: " .. (distanceEspEnabled and "Ativado ✅" or "Desativado ❌"), function(btn) toggleDistanceEsp(btn) end, Color3.fromRGB(150,150,100))
        distanceEspBtn.BackgroundTransparency = distanceEspEnabled and 0.5 or 0.85

        updateCanvas(mainCont)

        -- Página Korblox
        local korCont = contentContainers["Korblox"]
        createButtonSafe(korCont, "💀 Aplicar Melhor Korblox", applyBestKorblox, Color3.fromRGB(100,150,200))
        createButtonSafe(korCont, "🔄 Redefinir Korblox", resetKorblox, Color3.fromRGB(150,100,100))

        local headlessBtn = createButtonSafe(korCont, "👤 Sem Cabeça: " .. (headlessEnabled and "Ativado ✅" or "Desativado ❌"), function(btn) toggleHeadless(btn) end, Color3.fromRGB(150,150,200))
        headlessBtn.BackgroundTransparency = headlessEnabled and 0.5 or 0.85

        createButtonSafe(korCont, "🔄 Redefinir Sem Cabeça", function()
            for _, player in ipairs(Players:GetPlayers()) do if player.Character then resetHeadlessForCharacter(player.Character) end end
            headlessEnabled = false
            if headlessBtn then headlessBtn.Text = "👤 Sem Cabeça: Desativado ❌"; headlessBtn.BackgroundTransparency = 0.85 end
            showNotice("Efeito sem cabeça redefinido", true)
        end, Color3.fromRGB(150,100,100))

        pcall(function()
            local colorPreview = Instance.new("Frame", korCont)
            colorPreview.Size = UDim2.new(0.95, 0, 0, 30)
            colorPreview.BackgroundColor3 = K_COLOR
            colorPreview.BackgroundTransparency = 0.2
            Instance.new("UICorner", colorPreview).CornerRadius = UDim.new(0, 6)
            local colorLabel = Instance.new("TextLabel", colorPreview)
            colorLabel.Size = UDim2.new(1,0,1,0)
            colorLabel.Text = "Cor exclusiva Korblox #264144"
            colorLabel.TextColor3 = Color3.new(1,1,1)
            colorLabel.BackgroundTransparency = 1
            colorLabel.Font = Enum.Font.GothamBold
            colorLabel.TextSize = 14
        end)
        updateCanvas(korCont)

        -- Página Outros
        local otherCont = contentContainers["Outros"]
        createButtonSafe(otherCont, "🔄 Reentrar no servidor", function() TeleportService:Teleport(game.PlaceId, lp) end, Color3.fromRGB(150,100,200))
        createButtonSafe(otherCont, "📋 Copiar USER ID", function()
            if setclipboard then setclipboard(tostring(lp.UserId)); showNotice("✅ UserID copiado: " .. lp.UserId, true) end
        end, Color3.fromRGB(80,120,150))
        createButtonSafe(otherCont, "🔄 Reviver a si mesmo", function()
            local remote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Player") and ReplicatedStorage.Events.Player:FindFirstChild("ChangePlayerMode")
            if remote then
                local character = lp.Character
                if character and character:GetAttribute("Downed") then
                    local success, err = pcall(function() remote:FireServer(true) end)
                    if success then showNotice("🔄 Tentativa de reviver", true) else showNotice("⚠️ Falha ao reviver: " .. tostring(err), true) end
                else showNotice("⚠️ Não está caído ou sem personagem", true) end
            else showNotice("⚠️ Evento de reviver não encontrado", true) end
        end, Color3.fromRGB(100,200,100))

        local autoReviveBtn = createButtonSafe(otherCont, "🔄 Auto Reviver: " .. (autoReviveEnabled and "Ativado ✅" or "Desativado ❌"), function(btn) toggleAutoRevive(btn) end, Color3.fromRGB(70,150,70))
        autoReviveBtn.BackgroundTransparency = autoReviveEnabled and 0.5 or 0.85

        createButtonSafe(otherCont, "📛 Renomeador de Itens", function() createRenamerWindow() end, Color3.fromRGB(180, 130, 200))
        createButtonSafe(otherCont, "📍 Teletransporte de Jogador", function() createTeleportWindow() end, Color3.fromRGB(100,150,200))

        local edgeBoostBtn = createButtonSafe(otherCont, "⚡ Impulso de Borda (V7): " .. (edgeBoostEnabled and "Ativado ✅" or "Desativado ❌"), toggleEdgeBoost, Color3.fromRGB(200, 180, 100))
        edgeBoostBtn.BackgroundTransparency = edgeBoostEnabled and 0.5 or 0.85

        pcall(function() createSlider(otherCont, "Força do Impulso", {50, 200}, 5, "", edgeBoostPower, function(val) edgeBoostPower = val end) end)
        pcall(function() createSlider(otherCont, "Sensibilidade do Gatilho", {0.0, 5.0}, 0.2, "", edgeBoostMinYVelocity, function(val) edgeBoostMinYVelocity = val end) end)

        local isAuthor = false
        for _, name in ipairs(AUTHOR_USERNAMES) do if lp.Name == name then isAuthor = true break end end
        if isAuthor then
            createButtonSafe(otherCont, "📢 Enviar Broadcast", function() createBroadcastWindow() end, Color3.fromRGB(200,150,100))
        end

        updateCanvas(otherCont)

        -- Página Outros 2
        local other2Cont = contentContainers["Outros 2"]
        if other2Cont then
            createButtonSafe(other2Cont, "☁️ Farm Aéreo: " .. (autoFarmEnabled and "Ativado ✅" or "Desativado ❌"), 
                function(btn) 
                    toggleAutoFarm()
                    btn.Text = "☁️ Farm Aéreo: " .. (autoFarmEnabled and "Ativado ✅" or "Desativado ❌")
                    btn.BackgroundTransparency = autoFarmEnabled and 0.5 or 0.85
                end, Color3.fromRGB(100, 150, 200))

            createButtonSafe(other2Cont, "🚑 Auto Resgate: " .. (autoRescueEnabled and "Ativado ✅" or "Desativado ❌"), 
                function(btn) 
                    toggleAutoRescue()
                    btn.Text = "🚑 Auto Resgate: " .. (autoRescueEnabled and "Ativado ✅" or "Desativado ❌")
                    btn.BackgroundTransparency = autoRescueEnabled and 0.5 or 0.85
                end, Color3.fromRGB(200, 100, 100))

            createButtonSafe(other2Cont, "💰 Auto Coleta: " .. (autoCollectEnabled and "Ativado ✅" or "Desativado ❌"), 
                function(btn) 
                    toggleAutoCollect()
                    btn.Text = "💰 Auto Coleta: " .. (autoCollectEnabled and "Ativado ✅" or "Desativado ❌")
                    btn.BackgroundTransparency = autoCollectEnabled and 0.5 or 0.85
                end, Color3.fromRGB(100, 200, 150))

            updateCanvas(other2Cont)
        end

        if contentContainers["Principal"] then contentContainers["Principal"].Visible = true end
        if tabButtons["Principal"] then tabButtons["Principal"].BackgroundTransparency = 0.1; tabButtons["Principal"].TextColor3 = Color3.new(1,1,1) end

        local closeBtn = Instance.new("TextButton", main)
        closeBtn.Size = UDim2.new(0.3, 0, 0, 40)
        closeBtn.Position = UDim2.new(0.35, 0, 0.94, 0)
        closeBtn.Text = "✕ Fechar Painel"
        closeBtn.BackgroundColor3 = Color3.fromRGB(200,80,80)
        closeBtn.BackgroundTransparency = 0.3
        closeBtn.TextColor3 = Color3.new(1,1,1)
        closeBtn.Font = Enum.Font.GothamBold
        closeBtn.TextSize = 16
        Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 8)
        closeBtn.MouseButton1Click:Connect(function() 
            mainPanel = nil
            sg:Destroy() 
        end)

        print("[MyCommander] Painel de controle criado")
        mainPanel = sg
        return sg
    end)
end

function toggleAdminPanel()
    if mainPanel then
        pcall(function() mainPanel:Destroy() end)
        mainPanel = nil
        print("[MyCommander] Painel fechado")
    else
        createAdminPanel()
        print("[MyCommander] Painel aberto")
    end
end

-- ==================== Loop de auto reviver ====================
task.spawn(function()
    while true do
        if autoReviveEnabled and reviveRemote then
            pcall(function()
                local gameFolder = workspace:FindFirstChild("Game")
                local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")
                local inGameCharacter = nil
                if playersFolder then
                    inGameCharacter = playersFolder:FindFirstChild(lp.Name) or playersFolder:FindFirstChild(tostring(lp.UserId))
                end
                if not inGameCharacter then
                    reviveRemote:FireServer(true)
                    task.wait(2)
                else
                    local humanoid = inGameCharacter:FindFirstChild("Humanoid")
                    local isDead = humanoid and (humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead)
                    local state = inGameCharacter:GetAttribute("State") or ""
                    local isDowned = inGameCharacter:GetAttribute("Downed") or (state == "Downed") or (state == "Dead")
                    if isDead or isDowned then
                        reviveRemote:FireServer(true)
                        task.wait(2)
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

