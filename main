-- Controlar automaticamente o Anti-AFK com base nas funções de automação
local function updateAntiAFK()
    local needAntiAFK = autoFarmEnabled or autoRescueEnabled or autoCollectEnabled
    if needAntiAFK and not antiAfkEnabled then
        if antiAfkConnection then antiAfkConnection:Disconnect() end
        antiAfkEnabled = true
        task.spawn(function()
            while antiAfkEnabled do
                pcall(function()
                    VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                    task.wait(0.1)
                    VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                end)
                task.wait(60)
            end
        end)
        local panel = PlayerGui:FindFirstChild("MyCommanderPanel")
        if panel then
            local mainCont = panel:FindFirstChild("Container Principal")
            if mainCont then
                for _, btn in ipairs(mainCont:GetChildren()) do
                    if btn:IsA("TextButton") and btn.Text:find("Anti-AFK") then
                        btn.Text = "🛡️ Anti-AFK: Ativado ✅"
                        btn.BackgroundTransparency = 0.5
                        break
                    end
                end
            end
        end
        print("[AntiAFK] Ativado automaticamente")
    elseif not needAntiAFK and antiAfkEnabled then
        antiAfkEnabled = false
        local panel = PlayerGui:FindFirstChild("MyCommanderPanel")
        if panel then
            local mainCont = panel:FindFirstChild("Container Principal")
            if mainCont then
                for _, btn in ipairs(mainCont:GetChildren()) do
                    if btn:IsA("TextButton") and btn.Text:find("Anti-AFK") then
                        btn.Text = "🛡️ Anti-AFK: Desativado ❌"
                        btn.BackgroundTransparency = 0.85
                        break
                    end
                end
            end
        end
        print("[AntiAFK] Desativado automaticamente")
    end
end

local function refreshPanelButtons()
    local possibleParents = { PlayerGui, game:GetService("CoreGui") }
    if gethui then table.insert(possibleParents, gethui()) end
    local panel = nil
    for _, parent in ipairs(possibleParents) do
        panel = parent:FindFirstChild("MyCommanderPanel")
        if panel then break end
    end
    if not panel then return end
    local other2Cont = panel:FindFirstChild("Container Outros 2")
    if other2Cont then
        for _, btn in ipairs(other2Cont:GetChildren()) do
            if btn:IsA("TextButton") then
                local text = btn.Text
                if text:find("Farm Aéreo") then
                    btn.Text = "☁️ Farm Aéreo: " .. (autoFarmEnabled and "Ativado ✅" or "Desativado ❌")
                    btn.BackgroundTransparency = autoFarmEnabled and 0.5 or 0.85
                elseif text:find("Auto Resgate") then
                    btn.Text = "🚑 Auto Resgate: " .. (autoRescueEnabled and "Ativado ✅" or "Desativado ❌")
                    btn.BackgroundTransparency = autoRescueEnabled and 0.5 or 0.85
                elseif text:find("Auto Coleta") or text:find("💰") then
                    btn.Text = "💰 Auto Coleta: " .. (autoCollectEnabled and "Ativado ✅" or "Desativado ❌")
                    btn.BackgroundTransparency = autoCollectEnabled and 0.5 or 0.85
                end
            end
        end
    end
    local mainCont = panel:FindFirstChild("Container Principal")
    if mainCont then
        for _, btn in ipairs(mainCont:GetChildren()) do
            if btn:IsA("TextButton") and btn.Text:find("Anti-AFK") then
                btn.Text = "🛡️ Anti-AFK: " .. (antiAfkEnabled and "Ativado ✅" or "Desativado ❌")
                btn.BackgroundTransparency = antiAfkEnabled and 0.5 or 0.85
                break
            end
        end
    end
end

-- ==================== Impulso de borda (detecção de toque V7) ====================
local function isBouncePart(part)
    local bounceKeywords = {"bounce", "boost", "launch", "jump", "pad", "ramp", "platform"}
    local name = string.lower(part.Name)
    for _, kw in ipairs(bounceKeywords) do
        if name:find(kw) then return true end
    end
    if part.Parent and (part.Parent:IsA("Model") or part.Parent:IsA("Folder")) then
        local parentName = string.lower(part.Parent.Name)
        for _, kw in ipairs(bounceKeywords) do
            if parentName:find(kw) then return true end
        end
    end
    return false
end

local function applyEdgeBoost()
    if not edgeBoostEnabled then return end
    local character = lp.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not hrp or not humanoid or humanoid.Health <= 0 then return end

    local currentYVelocity = hrp.AssemblyLinearVelocity.Y
    if currentYVelocity >= -edgeBoostMinYVelocity then return end

    local touchingParts = hrp:GetTouchingParts()
    local isTouchingEdge = false
    local isTouchingBounce = false

    if #touchingParts > 0 then
        for _, part in ipairs(touchingParts) do
            if isBouncePart(part) then
                isTouchingBounce = true
                break
            end
        end
        isTouchingEdge = not isTouchingBounce
    end

    if isTouchingEdge then
        local horizontalVel = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
        hrp.AssemblyLinearVelocity = horizontalVel + Vector3.new(0, edgeBoostPower, 0)
    end
end

local function refreshEdgeBoostConnection()
    if edgeBoostConnection then edgeBoostConnection:Disconnect(); edgeBoostConnection = nil end
    if edgeBoostEnabled then
        edgeBoostConnection = RunService.Stepped:Connect(applyEdgeBoost)
    end
end

local function toggleEdgeBoost(btn)
    edgeBoostEnabled = not edgeBoostEnabled
    if btn then
        btn.Text = "⚡ Impulso de Borda (V7): " .. (edgeBoostEnabled and "Ativado ✅" or "Desativado ❌")
        btn.BackgroundTransparency = edgeBoostEnabled and 0.5 or 0.85
    end
    refreshEdgeBoostConnection()
    showNotice("Impulso de borda (V7) " .. (edgeBoostEnabled and "ativado" or "desativado"), true)
end

refreshEdgeBoostConnection()
edgeBoostInputConnection = UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.U then
        toggleEdgeBoost()
        local panel = PlayerGui:FindFirstChild("MyCommanderPanel")
        if panel then
            local otherCont = panel:FindFirstChild("Container Outros")
            if otherCont then
                for _, btn in ipairs(otherCont:GetChildren()) do
                    if btn:IsA("TextButton") and btn.Text:find("Impulso de Borda") then
                        btn.Text = "⚡ Impulso de Borda (V7): " .. (edgeBoostEnabled and "Ativado ✅" or "Desativado ❌")
                        btn.BackgroundTransparency = edgeBoostEnabled and 0.5 or 0.85
                        break
                    end
                end
            end
        end
    end
end)
lp.CharacterAdded:Connect(function()
    task.wait(0.5)
    refreshEdgeBoostConnection()
end)

-- ==================== Janela de teletransporte de jogadores ====================
local function createTeleportWindow()
    safeCall(function()
        if teleportWindowActive and teleportGui and teleportGui.Parent then
            teleportGui:Destroy()
            teleportWindowActive = false
            teleportGui = nil
            return
        end

        local sg = Instance.new("ScreenGui")
        sg.Name = "TeleportWindow"
        sg.IgnoreGuiInset = true
        sg.ResetOnSpawn = false
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

        if syn and syn.protect_gui then
            syn.protect_gui(sg)
            sg.Parent = game:GetService("CoreGui")
        elseif gethui then
            sg.Parent = gethui()
        else
            sg.Parent = PlayerGui
        end

        local main = Instance.new("Frame", sg)
        main.Size = UDim2.new(0, 350, 0, 250)
        main.Position = UDim2.new(1, -370, 0.5, -125)
        main.BackgroundColor3 = Color3.fromRGB(20,20,30)
        main.BackgroundTransparency = 0.1
        main.BorderSizePixel = 0
        main.Active = true
        main.Draggable = true
        Instance.new("UICorner", main).CornerRadius = UDim.new(0, 15)

        local titleBar = Instance.new("Frame", main)
        titleBar.Size = UDim2.new(1, 0, 0, 40)
        titleBar.BackgroundTransparency = 1

        local title = Instance.new("TextLabel", titleBar)
        title.Size = UDim2.new(1, -40, 1, 0)
        title.Position = UDim2.new(0, 10, 0, 0)
        title.Text = "📍 Teletransporte de Jogador"
        title.TextColor3 = Color3.fromRGB(200,200,255)
        title.BackgroundTransparency = 1
        title.TextSize = 22
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left

        local closeBtn = Instance.new("TextButton", titleBar)
        closeBtn.Size = UDim2.new(0, 30, 0, 30)
        closeBtn.Position = UDim2.new(1, -35, 0, 5)
        closeBtn.Text = "✕"
        closeBtn.TextColor3 = Color3.new(1, 0.5, 0.5)
        closeBtn.BackgroundTransparency = 1
        closeBtn.TextSize = 20
        closeBtn.Font = Enum.Font.GothamBold
        closeBtn.MouseButton1Click:Connect(function()
            sg:Destroy()
            teleportWindowActive = false
            teleportGui = nil
        end)

        local tipLabel = Instance.new("TextLabel", main)
        tipLabel.Size = UDim2.new(0.9, 0, 0, 30)
        tipLabel.Position = UDim2.new(0.05, 0, 0.15, 0)
        tipLabel.BackgroundTransparency = 1
        tipLabel.Text = "Selecione o jogador para teleportar:"
        tipLabel.TextColor3 = Color3.new(1,1,1)
        tipLabel.TextSize = 18
        tipLabel.Font = Enum.Font.GothamSemibold
        tipLabel.TextXAlignment = Enum.TextXAlignment.Left

        local dropdownBtn = Instance.new("TextButton", main)
        dropdownBtn.Size = UDim2.new(0.9, 0, 0, 45)
        dropdownBtn.Position = UDim2.new(0.05, 0, 0.25, 0)
        dropdownBtn.Text = "Selecionar jogador"
        dropdownBtn.BackgroundColor3 = Color3.fromRGB(30,30,40)
        dropdownBtn.BackgroundTransparency = 0.3
        dropdownBtn.TextColor3 = Color3.new(1,1,1)
        dropdownBtn.Font = Enum.Font.GothamSemibold
        dropdownBtn.TextSize = 18
        Instance.new("UICorner", dropdownBtn).CornerRadius = UDim.new(0, 8)

        local listFrame = Instance.new("ScrollingFrame", main)
        listFrame.Size = UDim2.new(0.9, 0, 0, 120)
        listFrame.Position = UDim2.new(0.05, 0, 0.38, 0)
        listFrame.BackgroundColor3 = Color3.fromRGB(30,30,40)
        listFrame.BackgroundTransparency = 0.1
        listFrame.BorderSizePixel = 0
        listFrame.Visible = false
        listFrame.ZIndex = 10
        Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 8)

        local layout = Instance.new("UIListLayout", listFrame)
        layout.Padding = UDim.new(0, 2)

        local selectedPlayer = nil
        local function refreshPlayerList()
            for _, v in pairs(listFrame:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
            local players = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= lp then table.insert(players, plr) end
            end
            table.sort(players, function(a,b) return a.Name < b.Name end)
            listFrame.CanvasSize = UDim2.new(0, 0, 0, #players * 35)

            for _, plr in ipairs(players) do
                local btn = Instance.new("TextButton", listFrame)
                btn.Size = UDim2.new(1, 0, 0, 35)
                btn.BackgroundTransparency = 1
                btn.Text = plr.Name .. "  [" .. plr.DisplayName .. "]"
                btn.TextColor3 = Color3.new(1,1,1)
                btn.Font = Enum.Font.Gotham
                btn.TextSize = 16
                btn.ZIndex = 11
                btn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    dropdownBtn.Text = plr.Name
                    listFrame.Visible = false
                end)
            end
        end

        dropdownBtn.MouseButton1Click:Connect(function()
            refreshPlayerList()
            listFrame.Visible = not listFrame.Visible
        end)

        local goToBtn = Instance.new("TextButton", main)
        goToBtn.Size = UDim2.new(0.4, 0, 0, 45)
        goToBtn.Position = UDim2.new(0.05, 0, 0.7, 0)
        goToBtn.Text = "Ir até ele"
        goToBtn.BackgroundColor3 = Color3.fromRGB(70,120,70)
        goToBtn.BackgroundTransparency = 0.3
        goToBtn.TextColor3 = Color3.new(1,1,1)
        goToBtn.Font = Enum.Font.GothamBold
        goToBtn.TextSize = 18
        Instance.new("UICorner", goToBtn).CornerRadius = UDim.new(0, 8)

        local bringBtn = Instance.new("TextButton", main)
        bringBtn.Size = UDim2.new(0.4, 0, 0, 45)
        bringBtn.Position = UDim2.new(0.55, 0, 0.7, 0)
        bringBtn.Text = "Trazer ele"
        bringBtn.BackgroundColor3 = Color3.fromRGB(150,100,200)
        bringBtn.BackgroundTransparency = 0.3
        bringBtn.TextColor3 = Color3.new(1,1,1)
        bringBtn.Font = Enum.Font.GothamBold
        bringBtn.TextSize = 18
        Instance.new("UICorner", bringBtn).CornerRadius = UDim.new(0, 8)

        goToBtn.MouseButton1Click:Connect(function()
            if not selectedPlayer then showNotice("⚠️ Selecione um jogador primeiro", true) return end
            if not selectedPlayer.Character or not selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then showNotice("⚠️ O jogador alvo não existe ou não tem personagem", true) return end
            if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then showNotice("⚠️ Você não tem um personagem no momento", true) return end
            local targetPos = selectedPlayer.Character.HumanoidRootPart.Position
            lp.Character.HumanoidRootPart.CFrame = CFrame.new(targetPos)
            showNotice("✅ Teleportado para " .. selectedPlayer.Name, true)
        end)

        bringBtn.MouseButton1Click:Connect(function()
            if not selectedPlayer then showNotice("⚠️ Selecione um jogador primeiro", true) return end
            if not selectedPlayer.Character or not selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then showNotice("⚠️ O jogador alvo não existe ou não tem personagem", true) return end
            if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then showNotice("⚠️ Você não tem um personagem no momento", true) return end
            local myPos = lp.Character.HumanoidRootPart.Position
            selectedPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(myPos)
            showNotice("✅ " .. selectedPlayer.Name .. " foi trazido até você", true)
        end)

        refreshPlayerList()
        teleportWindowActive = true
        teleportGui = sg
    end)
end

-- ==================== Farm aéreo otimizado (movimento circular + plataforma) ====================
local SKY_X = 0
local SKY_Y = 500
local SKY_Z = 0
local RADIUS = 800         -- raio do círculo, quanto maior mais próximo da borda do mapa
local ROTATE_SPEED = 0.8   -- velocidade angular, quanto maior mais rápido
local PLATFORM_SIZE = 12
local angle = 0            -- ângulo atual
local skyPlatform = nil
local savedGroundPosition = nil
local respawnHandlerAdded = false

local function createSkyPlatform()
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return nil end
    if skyPlatform and skyPlatform.Parent then skyPlatform:Destroy(); skyPlatform = nil end
    local hrp = lp.Character.HumanoidRootPart
    local platformPos = hrp.Position - Vector3.new(0, 2.5, 0)
    local platform = Instance.new("Part")
    platform.Size = Vector3.new(PLATFORM_SIZE, 1, PLATFORM_SIZE)
    platform.Position = platformPos
    platform.Anchored = true
    platform.CanCollide = true
    platform.Transparency = 0.5
    platform.BrickColor = BrickColor.new("Bright blue")
    platform.Material = Enum.Material.Plastic
    platform.Name = "SkyPlatform_XUAN"
    platform.Parent = workspace
    return platform
end

local function destroySkyPlatform()
    if skyPlatform and skyPlatform.Parent then 
        skyPlatform:Destroy() 
    end
    skyPlatform = nil
end

function teleportToSky()
    -- Inicializa o personagem no alto (depois o Heartbeat assume o movimento)
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    local targetPos = Vector3.new(SKY_X, SKY_Y, SKY_Z)
    lp.Character.HumanoidRootPart.CFrame = CFrame.new(targetPos)
    task.wait(0.2)
    if not skyPlatform or not skyPlatform.Parent then
        skyPlatform = createSkyPlatform()
    else
        local newPos = lp.Character.HumanoidRootPart.Position - Vector3.new(0, 2.5, 0)
        skyPlatform.Position = newPos
    end
end

local function getSpawnPosition()
    local spawn = workspace:FindFirstChild("SpawnLocation")
    if spawn and spawn:IsA("SpawnLocation") then return spawn.Position end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then return obj.Position end
    end
    local highestY = 100
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Position.Y > highestY then highestY = obj.Position.Y end
    end
    return Vector3.new(0, highestY + 10, 0)
end

local function returnToGround()
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    local target = savedGroundPosition or getSpawnPosition()
    savedGroundPosition = nil
    lp.Character.HumanoidRootPart.CFrame = CFrame.new(target)
    showNotice("Retornou ao chão", true)
end

local hasCollectibleItems = false

local function autoFarmHeartbeat(deltaTime)
    if currentCollecting then return end
    if not autoFarmEnabled then return end
    if autoRescueEnabled and activeRescueTarget ~= nil then return end
    if autoCollectEnabled and hasCollectibleItems then return end

    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = lp.Character.HumanoidRootPart

    -- Movimento circular uniforme
    angle = angle + ROTATE_SPEED * deltaTime
    local newPos = Vector3.new(
        math.cos(angle) * RADIUS,
        SKY_Y,
        math.sin(angle) * RADIUS
    )
    hrp.CFrame = CFrame.new(newPos)

    -- A plataforma sempre permanece sob os pés
    if not skyPlatform or not skyPlatform.Parent then
        skyPlatform = createSkyPlatform()
    else
        skyPlatform.Position = newPos - Vector3.new(0, 2.5, 0)
    end

    -- Dá uma velocidade tangencial ao personagem (anti-detecção, não essencial)
    local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
    hrp.Velocity = tangent * (RADIUS * ROTATE_SPEED)
end

function startAutoFarm()
    if farmConnection then farmConnection:Disconnect() end
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        savedGroundPosition = lp.Character.HumanoidRootPart.Position
    else
        savedGroundPosition = nil
    end
    -- Calcula o ângulo inicial com base na posição atual do personagem
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local pos = lp.Character.HumanoidRootPart.Position
        angle = math.atan2(pos.Z, pos.X)
    else
        angle = 0
    end
    teleportToSky()   -- Primeiro vai para o alto (o heartbeat assumirá o círculo imediatamente)
    farmConnection = RunService.Heartbeat:Connect(function(dt)
        autoFarmHeartbeat(dt)
    end)
end

function stopAutoFarm()
    if farmConnection then farmConnection:Disconnect(); farmConnection = nil end
    destroySkyPlatform()
    task.spawn(returnToGround)
end

function toggleAutoFarm()
    autoFarmEnabled = not autoFarmEnabled
    if autoFarmEnabled then
        startAutoFarm()
        showNotice("☁️ Farm aéreo ativado", true)
    else
        stopAutoFarm()
        showNotice("💤 Farm aéreo desativado", true)
    end
    updateAntiAFK()
    refreshPanelButtons()
end

if not respawnHandlerAdded then
    respawnHandlerAdded = true
    lp.CharacterAdded:Connect(function(character)
        task.wait(0.5)
        if autoFarmEnabled then
            -- Após renascer, vai direto para o alto, o heartbeat assumirá o círculo
            teleportToSky()
            print("[Farm Aéreo] Retornou automaticamente à plataforma alta após renascer")
        end
    end)
end

-- ==================== Coleta automática de itens (versão absolutamente pura) ====================
local autoCollectEnabled = false
local collectHeartbeatConnection = nil

-- ★ Coleta apenas estes dois itens
local COLLECT_KEYWORDS = {"Hexagons", "bee head"}
local TELEPORT_INTERVAL = 0.05
local MAX_TRY_TIME = 5
local SCAN_RADIUS = 4000

-- Obtém a posição do item
local function getItemPos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local p = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart")
        return p and p.Position
    end
    return nil
end

-- Correspondência exata de nome
local function matches(obj)
    for _, kw in ipairs(COLLECT_KEYWORDS) do
        if obj.Name == kw then return true end
    end
    return false
end

-- Encontra o alvo mais próximo
local function findNearest()
    local char = lp.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local bestObj, bestPos, bestDist = nil, nil, SCAN_RADIUS

    for _, obj in ipairs(workspace:GetDescendants()) do
        if not (obj:IsA("BasePart") or obj:IsA("Model")) then continue end
        if not matches(obj) then continue end
        local pos = getItemPos(obj)
        if not pos then continue end
        local dist = (myPos - pos).Magnitude
        if dist < bestDist then
            bestPos = pos
            bestDist = dist
            bestObj = obj
        end
    end
    if bestObj then return {obj = bestObj, pos = bestPos} end
end

-- Ciclo de coleta (versão com depuração aprimorada)
local function collectItem(item)
    local obj = item.obj
    local objName = obj and obj.Name or "desconhecido"
    local objFullName = obj and obj:GetFullName() or "desconhecido"   -- ★ caminho completo, fácil de identificar
    local pos = item.pos
    local start = os.clock()
    warn("[Coleta] Começando a seguir: " .. objFullName .. " coordenadas iniciais: " .. tostring(pos))
    while obj and obj.Parent do
        if os.clock() - start > MAX_TRY_TIME then
            warn("[Coleta] Tempo esgotado parando: " .. objFullName)
            return false
        end
        local char = lp.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        -- ★ Antes de obter a posição novamente, garanta que o objeto não mudou
        if obj ~= item.obj then
            warn("[Coleta] ❌ Referência do item alterada! O objeto original foi substituído, encerrando forçadamente.")
            return false
        end

        local curPos = getItemPos(obj)
        if curPos then
            pos = curPos
            print("[Coleta] 📍 Alvo atual: " .. objFullName .. " posição: " .. tostring(pos))
        else
            warn("[Coleta] ⚠️ Não foi possível obter a posição do item, pulando este teleporte")
            task.wait(TELEPORT_INTERVAL)
            continue
        end

        -- Teletransporta o personagem
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
        task.wait(TELEPORT_INTERVAL)
    end
    warn("[Coleta] ✅ Coletou com sucesso: " .. objFullName)
    return true
end

-- Loop principal
local function autoCollectLoop()
    if not autoCollectEnabled then return end
    if currentCollecting then return end

    local item = findNearest()
    if item then
        currentCollecting = true
        hasCollectibleItems = true
        warn("[Coleta] Alvo: " .. item.obj.Name)
        if collectItem(item) then
            hasCollectibleItems = false
            if autoFarmEnabled then teleportToSky() end
        end
        currentCollecting = false
    else
        hasCollectibleItems = false
    end
end

function startAutoCollect()
    if collectHeartbeatConnection then collectHeartbeatConnection:Disconnect() end
    collectHeartbeatConnection = RunService.Heartbeat:Connect(autoCollectLoop)
end

function stopAutoCollect()
    if collectHeartbeatConnection then collectHeartbeatConnection:Disconnect(); collectHeartbeatConnection = nil end
end

function toggleAutoCollect()
    autoCollectEnabled = not autoCollectEnabled
    if autoCollectEnabled then startAutoCollect() else stopAutoCollect() end
    updateAntiAFK()
    refreshPanelButtons()
    local panel = PlayerGui:FindFirstChild("MyCommanderPanel")
    if panel then
        local c = panel:FindFirstChild("Container Outros 2")
        if c then
            for _, b in ipairs(c:GetChildren()) do
                if b:IsA("TextButton") and (b.Text:find("Auto Coleta") or b.Text:find("💰")) then
                    b.Text = "💰 Auto Coleta: " .. (autoCollectEnabled and "Ativado ✅" or "Desativado ❌")
                    b.BackgroundTransparency = autoCollectEnabled and 0.5 or 0.85
                    break
                end
            end
        end
    end
end

-- ==================== Resgate automático de aliados caídos (definição antecipada) ====================
local simpleRescueEnabled = false
local simpleRescueConnection = nil
local autoRescueEnabled = false
local isRescuing = false
local rescueConnection = nil

function getDownedPlayers()
    local downedList = {}
    local gameFolder = workspace:FindFirstChild("Game")
    local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")
    if not playersFolder then return downedList end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == lp then continue end
        local character = playersFolder:FindFirstChild(player.Name) or playersFolder:FindFirstChild(tostring(player.UserId))
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            local isDowned = character:GetAttribute("Downed")
            local state = character:GetAttribute("State")
            local health = humanoid and humanoid.Health or 100
            if health <= 0 or isDowned or state == "Downed" then
                table.insert(downedList, player)
            end
        end
    end
    return downedList
end

function findNearestDowned()
    local nearest = nil
    local minDist = math.huge
    local myPos = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character.HumanoidRootPart.Position
    if not myPos then return nil end
    local gameFolder = workspace:FindFirstChild("Game")
    local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")
    if not playersFolder then return nil end
    for _, player in ipairs(getDownedPlayers()) do
        local character = playersFolder:FindFirstChild(player.Name) or playersFolder:FindFirstChild(tostring(player.UserId))
        if character then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (myPos - hrp.Position).Magnitude
                if dist < minDist then minDist = dist; nearest = player end
            end
        end
    end
    return nearest
end

function pressE()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
        task.wait(1.5)
        vim:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
    end)
end

task.spawn(function()
    task.wait(3)
    local charEvents = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Character")
    if charEvents then
        print("=== Lista de eventos remotos de Character ===")
        for _, ev in ipairs(charEvents:GetChildren()) do
            if ev:IsA("RemoteEvent") then
                print("  - " .. ev.Name)
            end
        end
        print("==============================")
    else
        warn("Events.Character não encontrado")
    end
end)

function startAutoRescue()
    if rescueConnection then rescueConnection:Disconnect() end
    print("[Auto Resgate] Iniciando monitoramento de resgate...")
    local interactRemote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Character") and ReplicatedStorage.Events.Character:FindFirstChild("Interact")
    rescueConnection = RunService.Heartbeat:Connect(function()
        if not autoRescueEnabled then return end
        if isRescuing then return end
        if not lp.Character then return end
        local myHumanoid = lp.Character:FindFirstChild("Humanoid")
        if not myHumanoid then return end
        if myHumanoid.Health <= 0 then return end
        local myState = lp.Character:GetAttribute("State") or ""
        local myDowned = lp.Character:GetAttribute("Downed")
        if myDowned or myState == "Downed" or myState == "Dead" then return end
        local downedPlayer = findNearestDowned()
        if not downedPlayer then return end
        isRescuing = true
        task.spawn(function()
            local targetCharacter = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Players") and (workspace.Game.Players:FindFirstChild(downedPlayer.Name) or workspace.Game.Players:FindFirstChild(tostring(downedPlayer.UserId)))
            if targetCharacter then
                local targetHRP = targetCharacter:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                        print("[Auto Resgate] Teleportando para perto de", downedPlayer.Name)
                        lp.Character.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
                        lp.Character.HumanoidRootPart.CFrame = CFrame.lookAt(lp.Character.HumanoidRootPart.Position, targetHRP.Position)
                        if interactRemote then
                            pcall(function()
                                interactRemote:FireServer("Revive", true, downedPlayer.UserId)
                            end)
                            showNotice("✨ Resgate instantâneo de " .. downedPlayer.Name, true)
                        else
                            pressE()
                            showNotice("🚑 Resgatando " .. downedPlayer.Name, true)
                        end
                        task.wait(0.05)
                    end
                end
            end
            isRescuing = false
        end)
    end)
    print("[Auto Resgate] Monitoramento iniciado")
end

function stopAutoRescue()
    if rescueConnection then rescueConnection:Disconnect(); rescueConnection = nil; print("[Auto Resgate] Monitoramento interrompido") end
    isRescuing = false
end

function toggleAutoRescue()
    autoRescueEnabled = not autoRescueEnabled
    autoReviveEnabled = autoRescueEnabled
    print("[Auto Resgate] Estado alterado para:", autoRescueEnabled and "ativado" or "desativado")
    if autoRescueEnabled then
        startSimpleRescue()
        showNotice("✅ Auto resgate ativado", true)
    else
        stopSimpleRescue()
        showNotice("❌ Auto resgate desativado", true)
    end
    updateAntiAFK()
    refreshPanelButtons()
end

