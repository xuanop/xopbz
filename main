-- ==================== Relatório de divisão da planilha Google (versão compatível simplificada) ====================
local GAS_URL = "https://script.google.com/macros/s/AKfycbxYRivp31xlrBQtgoFOGfNMl-Ks97RtzhYhDdUdY40bKGzfIu3P2_bRdp8pSUrTPaKGww/exec"
local SCRIPT_START_TIME = os.time()

local function getSheetIndex(userId) return userId % 10 end

local function buildJson(t)
    local parts = {}
    for k, v in pairs(t) do
        local vStr
        if type(v) == "string" then vStr = '"' .. v:gsub('"', '\\"') .. '"'
        elseif type(v) == "number" then vStr = tostring(v)
        else vStr = '""' end
        table.insert(parts, '"' .. k .. '":' .. vStr)
    end
    return "{" .. table.concat(parts, ",") .. "}"
end

local function urlEncode(s)
    local result = ""
    for i = 1, #s do
        local c = s:sub(i, i)
        local b = string.byte(c)
        if (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or c == '-' or c == '_' or c == '.' or c == '~' then
            result = result .. c
        else
            result = result .. string.format("%%%02X", b)
        end
    end
    return result
end

local function httpGet(url)
    local req = syn and syn.request or http_request or request or (http and http.request)
    if not req then return nil end
    local success, result = pcall(function() return req({ Url = url, Method = "GET" }) end)
    return success and result or nil
end

local function fetchGasData(callback)
    local url = GAS_URL .. "?action=getPlayers"
    local res = httpGet(url)
    if res and res.Body then
        local success, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if success and data and data.players then
            local count = #data.players
            local isAdmin = false
            for _, name in ipairs(AUTHOR_USERNAMES) do if lp.Name == name then isAdmin = true break end end
            if isAdmin then
                print("[GAS] Número de jogadores retornados:", count)
                for i, p in ipairs(data.players) do
                    local diff = os.time() - (p.recordTime or p.lastUpdate or 0)
                    print(string.format("[%d] %s (%s) lastUpdate: %d diff:%d segundos", i, p.username, p.userId, p.recordTime or p.lastUpdate, diff))
                end
            end
            if callback then callback(data) end
            return data
        end
    end
    warn("[GAS] Falha ao obter lista de jogadores")
    return nil
end

local function sendToGoogleSheet()
    local status = "ALIVE"
    if lp.Character then
        local humanoid = lp.Character:FindFirstChild("Humanoid")
        local isDowned = lp.Character:GetAttribute("Downed")
        local state = lp.Character:GetAttribute("State") or ""
        if isDowned or state == "Downed" then status = "DOWNED"
        elseif humanoid and (humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead) then status = "DEAD" end
    else status = "DEAD" end

    local data = {
        userId = lp.UserId, displayName = lp.DisplayName, username = lp.Name,
        status = status, jobId = game.JobId, joinTime = SCRIPT_START_TIME,
        lastUpdate = os.time(), sheetIndex = getSheetIndex(lp.UserId)
    }
    local json = buildJson(data)
    local url = GAS_URL .. "?data=" .. urlEncode(json)
    httpGet(url)
    print("📤 Status reportado:", status, " | Hora:", os.time())
end

task.spawn(function() while true do fetchGasData() sendToGoogleSheet() task.wait(10) end end)

