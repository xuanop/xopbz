    if timeControlWindowActive and timeControlGui and timeControlGui.Parent then
        timeControlGui:Destroy()
        timeControlWindowActive = false
        timeControlGui = nil
        return
    end

    local Lighting = game:GetService("Lighting")

    local sg = Instance.new("ScreenGui")
    sg.Name = "TimeControlWindow"
