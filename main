        btn.Text = "👤 ESP Jogadores: " .. (playerEspEnabled and "Ativado ✅" or "Desativado ❌")
        btn.BackgroundTransparency = playerEspEnabled and 0.5 or 0.85
    end

    if playerEspEnabled then
