        previewBox.TextEditable = false
        Instance.new("UICorner", previewBox).CornerRadius = UDim.new(0, 6)
        Instance.new("UIPadding", previewBox).PaddingLeft = UDim.new(0, 10)

        local function updatePreview()
            if not targetItem or not sourceName then
                previewBox.Text = "Selecione o alvo e o novo nome"
                return
            end
            local targetPath = targetItem.Name
            if string.match(targetPath, "[^%w_]") then
                targetPath = '["' .. targetPath .. '"]'
            else
                targetPath = '.' .. targetPath
            end
            previewBox.Text = string.format('game:GetService("ReplicatedStorage").Items.%s%s.Name = "%s"',
                currentCategory, targetPath, sourceName)
        end

        local function refreshLists()
            for _, v in pairs(leftList:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
            for _, v in pairs(rightList:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end

            local folder = CATEGORIES[currentCategory]
            if not folder then return end

            local items = {}
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("Folder") or child:IsA("ModuleScript") then
                    table.insert(items, child)
                end
            end
            table.sort(items, function(a, b) return a.Name < b.Name end)

            leftList.CanvasSize = UDim2.new(0, 0, 0, #items * 35)
            rightList.CanvasSize = UDim2.new(0, 0, 0, #items * 35)

            for _, item in ipairs(items) do
                local btnL = Instance.new("TextButton", leftList)
                btnL.Size = UDim2.new(1, 0, 0, 35)
                btnL.BackgroundTransparency = 1
                btnL.Text = item.Name
                btnL.TextColor3 = Color3.new(1,1,1)
                btnL.Font = Enum.Font.Gotham
                btnL.TextSize = 16
                btnL.ZIndex = 11
                btnL.MouseButton1Click:Connect(function()
                    targetItem = item
                    leftBtn.Text = item.Name
                    leftList.Visible = false
                    updatePreview()
                end)

                local btnR = Instance.new("TextButton", rightList)
                btnR.Size = UDim2.new(1, 0, 0, 35)
                btnR.BackgroundTransparency = 1
                btnR.Text = item.Name
                btnR.TextColor3 = Color3.new(1,1,1)
                btnR.Font = Enum.Font.Gotham
                btnR.TextSize = 16
                btnR.ZIndex = 11
                btnR.MouseButton1Click:Connect(function()
                    sourceName = item.Name
                    rightBtn.Text = item.Name
                    rightList.Visible = false
                    updatePreview()
                end)
            end
        end

        local tabFrame = Instance.new("Frame", main)
        tabFrame.Size = UDim2.new(0.92, 0, 0, 45)
        tabFrame.Position = UDim2.new(0.04, 0, 0.12, 0)
        tabFrame.BackgroundTransparency = 1

        local emoteTab = Instance.new("TextButton", tabFrame)
        emoteTab.Size = UDim2.new(0.48, 0, 1, 0)
        emoteTab.Text = "Emotes"
        emoteTab.BackgroundColor3 = Color3.fromRGB(40,40,60)
        emoteTab.BackgroundTransparency = 0.3
        emoteTab.TextColor3 = Color3.new(1,1,1)
        emoteTab.Font = Enum.Font.GothamBold
        emoteTab.TextSize = 18
        Instance.new("UICorner", emoteTab).CornerRadius = UDim.new(0, 8)

        local cosmeticTab = Instance.new("TextButton", tabFrame)
        cosmeticTab.Size = UDim2.new(0.48, 0, 1, 0)
        cosmeticTab.Position = UDim2.new(0.52, 0, 0, 0)
        cosmeticTab.Text = "Cosmetics"
        cosmeticTab.BackgroundColor3 = Color3.fromRGB(40,40,60)
        cosmeticTab.BackgroundTransparency = 0.5
        cosmeticTab.TextColor3 = Color3.new(1,1,1)
        cosmeticTab.Font = Enum.Font.GothamBold
        cosmeticTab.TextSize = 18
        Instance.new("UICorner", cosmeticTab).CornerRadius = UDim.new(0, 8)

        local applyBtn = Instance.new("TextButton", main)
        applyBtn.Size = UDim2.new(0.92, 0, 0, 55)
        applyBtn.Position = UDim2.new(0.04, 0, 0.72, 0)
        applyBtn.Text = "Renomear item"
        applyBtn.BackgroundColor3 = Color3.fromRGB(70,120,70)
        applyBtn.BackgroundTransparency = 0.3
        applyBtn.TextColor3 = Color3.new(1,1,1)
        applyBtn.Font = Enum.Font.GothamBold
        applyBtn.TextSize = 22
        Instance.new("UICorner", applyBtn).CornerRadius = UDim.new(0, 10)

        local statusLabel = Instance.new("TextLabel", main)
        statusLabel.Size = UDim2.new(1, 0, 0, 25)
        statusLabel.Position = UDim2.new(0, 0, 0.90, 0)
        statusLabel.BackgroundTransparency = 1
        statusLabel.Text = "Pronto"
        statusLabel.TextColor3 = Color3.new(0.9, 0.9, 0.9)
        statusLabel.TextSize = 16
        statusLabel.Font = Enum.Font.Gotham

        local function switchTab(cat)
            currentCategory = cat
            targetItem = nil
            sourceName = nil
            leftBtn.Text = "Selecionar alvo"
            rightBtn.Text = "Selecionar novo nome"
            leftList.Visible = false
            rightList.Visible = false
            previewBox.Text = ""

            if cat == "Emotes" then
                emoteTab.BackgroundTransparency = 0.3
                cosmeticTab.BackgroundTransparency = 0.5
            else
                cosmeticTab.BackgroundTransparency = 0.3
                emoteTab.BackgroundTransparency = 0.5
            end
            refreshLists()
        end

        emoteTab.MouseButton1Click:Connect(function() switchTab("Emotes") end)
        cosmeticTab.MouseButton1Click:Connect(function() switchTab("Cosmetics") end)

        applyBtn.MouseButton1Click:Connect(function()
    if not targetItem then
        statusLabel.Text = "Selecione o item alvo!"
        statusLabel.TextColor3 = Color3.new(1, 0.3, 0.3)
        return
    end
    if not sourceName then
        statusLabel.Text = "Selecione o novo nome!"
        statusLabel.TextColor3 = Color3.new(1, 0.3, 0.3)
        return
    end

    local oldName = targetItem.Name
    local folder = targetItem.Parent
    local newName = sourceName

    -- Duplicação central: clona um backup e depois renomeia o original
    local function dupRename(folder, old, new)
        local item = folder:FindFirstChild(old)
        if not item then return nil end
        print("[Renomeador] CLONE BACKUP: " .. old)
        local backup = item:Clone()
        backup.Parent = folder
        item.Name = new
        return item
    end

    local success, err = pcall(function()
        local newItem = dupRename(folder, oldName, newName)
        if not newItem then error("Item original não encontrado") end

        -- Limpeza geral: remove possíveis módulos antigos que interfiram
        local moduleToRemove = newItem:FindFirstChild("EmoteModuleClassic")
        if moduleToRemove then
            moduleToRemove:Destroy()
            print("[Renomeador] EmoteModuleClassic removido")
        end

        -- Sincronização especial: se o item contiver animações clássicas múltiplas, inicia sincronia em tempo real
        local animOptions = newItem:FindFirstChild("PossibleOptionsClassic")
        if animOptions then
            local animContainer = newItem:FindFirstChild("AnimationClassic")
            if not animContainer then
                animContainer = Instance.new("Animation")
                animContainer.Name = "AnimationClassic"
                animContainer.Parent = newItem
            end

            local anims = {}
            for _, key in ipairs({"A", "B", "C"}) do
                local opt = animOptions:FindFirstChild(key)
                local anim = opt and opt:FindFirstChildOfClass("Animation")
                if anim then
                    table.insert(anims, anim.AnimationId)
                end
            end

            if #anims > 0 then
                task.spawn(function()
                    local interval = 2
                    while newItem.Parent do
                        local totalTime = workspace:GetServerTimeNow()
                        local index = (math.floor(totalTime / interval) % #anims) + 1
                        if animContainer.AnimationId ~= anims[index] then
                            animContainer.AnimationId = anims[index]
                        end
                        task.wait(0)
                    end
                end)
                print("[Renomeador] Ciclo de sincronização de animação iniciado")
            end
        end
    end)

    if success then
        statusLabel.Text = "✅ Renomeado com sucesso!"
        statusLabel.TextColor3 = Color3.new(0.3, 1, 0.3)
        refreshLists()
        leftBtn.Text = sourceName
        updatePreview()
    else
        statusLabel.Text = "❌ Falha ao renomear"
        statusLabel.TextColor3 = Color3.new(1, 0.3, 0.3)
        warn("[Renomeador] Erro: " .. tostring(err))
    end
end)
        switchTab("Emotes")
        renamerWindowActive = true
        renamerGui = sg
    end)
end

-- ==================== Função auxiliar: criar slider ====================
local function createSlider(container, name, range, increment, suffix, defaultValue, callback)
    return safeCall(function()
        local sliderFrame = Instance.new("Frame", container)
        sliderFrame.Size = UDim2.new(0.95, 0, 0, 70)
        sliderFrame.BackgroundColor3 = Color3.fromRGB(30,30,40)
        sliderFrame.BackgroundTransparency = 0.3
        sliderFrame.BorderSizePixel = 0
        Instance.new("UICorner", sliderFrame).CornerRadius = UDim.new(0, 8)

        local nameLabel = Instance.new("TextLabel", sliderFrame)
        nameLabel.Size = UDim2.new(1,0,0,25)
        nameLabel.Position = UDim2.new(0,5,0,5)
        nameLabel.Text = name .. " :"
        nameLabel.TextColor3 = Color3.new(1,1,1)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamSemibold
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left

        local valueLabel = Instance.new("TextLabel", sliderFrame)
        valueLabel.Size = UDim2.new(0,50,0,25)
        valueLabel.Position = UDim2.new(1,-55,0,5)
        valueLabel.Text = tostring(defaultValue) .. suffix
        valueLabel.TextColor3 = Color3.new(1,1,1)
        valueLabel.BackgroundTransparency = 1
        valueLabel.TextSize = 14
        valueLabel.Font = Enum.Font.GothamSemibold
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right

        local barBg = Instance.new("Frame", sliderFrame)
        barBg.Size = UDim2.new(0.9, 0, 0, 12)
        barBg.Position = UDim2.new(0.05, 0, 0.6, 0)
        barBg.BackgroundColor3 = Color3.fromRGB(50,50,60)
        barBg.BackgroundTransparency = 0.5
        Instance.new("UICorner", barBg).CornerRadius = UDim.new(0,6)

        local barFill = Instance.new("Frame", barBg)
        barFill.Size = UDim2.new((defaultValue - range[1]) / (range[2] - range[1]), 0, 1, 0)
        barFill.BackgroundColor3 = Color3.fromRGB(100,150,255)
        Instance.new("UICorner", barFill).CornerRadius = UDim.new(0,6)

        local dragButton = Instance.new("TextButton", sliderFrame)
        dragButton.Size = UDim2.new(0.95, 0, 0, 30)
        dragButton.Position = UDim2.new(0.025, 0, 0.55, 0)
        dragButton.BackgroundTransparency = 1
        dragButton.Text = ""

        local currentValue = defaultValue
        local dragging = false
        local dragConnection = nil

        local function updateSlider(pos)
            local absX = pos.X - barBg.AbsolutePosition.X
            local ratio = clamp(absX / barBg.AbsoluteSize.X, 0, 1)
            local newValue = math.floor((range[1] + (range[2] - range[1]) * ratio) / increment + 0.5) * increment
            newValue = clamp(newValue, range[1], range[2])
            if newValue ~= currentValue then
                currentValue = newValue
                barFill.Size = UDim2.new((currentValue - range[1]) / (range[2] - range[1]), 0, 1, 0)
                valueLabel.Text = tostring(currentValue) .. suffix
                pcall(callback, currentValue)
            end
        end

        dragButton.MouseButton1Down:Connect(function()
            dragging = true
            if dragConnection then dragConnection:Disconnect() end
            dragConnection = RunService.RenderStepped:Connect(function()
                if not dragging then
                    dragConnection:Disconnect()
                    dragConnection = nil
                    return
                end
                local mousePos = UIS:GetMouseLocation()
                updateSlider(Vector2.new(mousePos.X, mousePos.Y))
            end)
        end)

        local inputEndedConn = UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)

        barBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                local mousePos = UIS:GetMouseLocation()
                updateSlider(Vector2.new(mousePos.X, mousePos.Y))
            end
        end)

        return {
            Set = function(newValue)
                newValue = clamp(newValue, range[1], range[2])
                currentValue = newValue
                barFill.Size = UDim2.new((currentValue - range[1]) / (range[2] - range[1]), 0, 1, 0)
                valueLabel.Text = tostring(currentValue) .. suffix
                pcall(callback, currentValue)
            end,
            Destroy = function()
                if dragConnection then dragConnection:Disconnect() end
                if inputEndedConn then inputEndedConn:Disconnect() end
                sliderFrame:Destroy()
            end
        }
    end)
end

-- ==================== Atualizar tamanho do canvas ====================
local function updateCanvas(container)
    safeCall(function()
        local layout = container:FindFirstChildOfClass("UIListLayout")
        if layout then
            task.wait()
            container.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
        end
    end)
end

-- ==================== Função auxiliar: criar botão ====================
local function createButtonSafe(container, text, callback, color)
    local btn = nil
    pcall(function()
        btn = Instance.new("TextButton", container)
        btn.Size = UDim2.new(0.95, 0, 0, 45)
        btn.Text = text
        btn.BackgroundColor3 = color or Color3.fromRGB(60,60,80)
        btn.BackgroundTransparency = 0.4
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 15
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(function() callback(btn) end)
    end)
    return btn
end

-- ==================== Painel de múltiplas páginas (singleton estável) ====================
local mainPanel = nil

local function createAdminPanel()
    if mainPanel then return mainPanel end
    return safeCall(function()
        local sg = Instance.new("ScreenGui")
        sg.Name = "MyCommanderPanel"
        sg.DisplayOrder = 10
        sg.IgnoreGuiInset = true
        sg.ResetOnSpawn = false
        sg.Enabled = true
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

        if syn and syn.protect_gui then
            syn.protect_gui(sg)
            sg.Parent = game:GetService("CoreGui")
        elseif gethui then
            sg.Parent = gethui()
        else
            sg.Parent = PlayerGui
        end

        local main = Instance.new("Frame", sg)
        main.Size = UDim2.new(0, 600, 0, 700)
        main.Position = UDim2.new(1, -620, 0, 350)
        main.BackgroundColor3 = Color3.fromRGB(10,10,15)
        main.BackgroundTransparency = 0.15
        main.BorderSizePixel = 0
        main.Active = true
        main.Draggable = true
        Instance.new("UICorner", main).CornerRadius = UDim.new(0,20)

        local title = Instance.new("TextLabel", main)
        title.Size = UDim2.new(1,0,0,60)
        title.Text = "⚡ xuan /op ⚡"
        title.TextColor3 = Color3.fromRGB(200,200,255)
        title.BackgroundTransparency = 1
        title.TextSize = 24
        title.Font = Enum.Font.GothamBlack

        local tabFrame = Instance.new("Frame", main)
        tabFrame.Size = UDim2.new(0.9, 0, 0, 45)
        tabFrame.Position = UDim2.new(0.05, 0, 0.12, 0)
        tabFrame.BackgroundTransparency = 1

        local tabLayout = Instance.new("UIListLayout", tabFrame)
        tabLayout.FillDirection = Enum.FillDirection.Horizontal
        tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        tabLayout.Padding = UDim.new(0, 10)

        local tabs = {"Principal", "Korblox", "Outros", "Outros 2"}
        local tabButtons = {}
        local contentContainers = {}

        for i, name in ipairs(tabs) do
            local container = Instance.new("ScrollingFrame", main)
            container.Name = "Container " .. name
