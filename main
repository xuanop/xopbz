-- ==================== Popup de inicialização: escolha de renomeação do Broom (estilo notificação do sistema) ====================
local skipZombieStride = false  -- Marca global, controla se pula o backup do ZombieStride

task.spawn(function()
    repeat task.wait() until game:IsLoaded()
    task.wait(5)

    local bindable = Instance.new("BindableFunction")
    local choiceMade = false

    bindable.OnInvoke = function(answer)
        if not choiceMade then
            choiceMade = true
            if answer == "SwagWalk" then
                -- Escolheu SwagWalk: Broom → SwagWalk, e desativa o dup do ZombieStride
                local emotes = ReplicatedStorage:WaitForChild("Items", 10):WaitForChild("Emotes", 10)
                local broom = emotes:FindFirstChild("Broom")
                if broom then
                    broom.Name = "SwagWalk"
                    print("[Broom] Renomeado para SwagWalk, ZombieStride ignorado")
                end
                skipZombieStride = true
            else
                -- Escolheu Catdown (ou padrão por timeout)
                local emotes = ReplicatedStorage:WaitForChild("Items", 10):WaitForChild("Emotes", 10)
                local broom = emotes:FindFirstChild("Broom")
                if broom then
                    broom.Name = "Catdown"
                    print("[Broom] Renomeado para Catdown")
                end
            end
            bindable:Destroy()
        end
    end

    -- Envia notificação do sistema (mesmo estilo do módulo social)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Escolha de renomeação do Broom",
        Text = "Aplicar Broom como SwagWalk ou Catdown?",
        Duration = 999999,
        Button1 = "SwagWalk",
        Button2 = "Catdown",
        Callback = bindable
    })

    -- Proteção de timeout: após 30s se não escolher, padrão Catdown
    task.wait(30)
    if not choiceMade then
        choiceMade = true
        local emotes = ReplicatedStorage:WaitForChild("Items", 10):WaitForChild("Emotes", 10)
        local broom = emotes:FindFirstChild("Broom")
        if broom then
            broom.Name = "Catdown"
            print("[Broom] Timeout sem escolha, padrão renomeado para Catdown")
        end
        bindable:Destroy()
    end
end)


-- ==================== Renomeação automática (múltiplos pares + tentativas) ====================
task.spawn(function()
    local RENAME_PAIRS = {
        { "RockinStride", "Stride" },
        { "SnowmobileCruise", "BumperKart" },
        -- Broom já tratado pelo popup, removido daqui
    }

    repeat task.wait() until game:IsLoaded()
    task.wait(8)   -- Garante que o popup já tratou o Broom

    local items = ReplicatedStorage:FindFirstChild("Items")
    if not items then
        warn("[MyCommander] Items não encontrado, renomeação automática impossível")
        return
    end
    local emotes = items:FindFirstChild("Emotes")
    if not emotes then
        warn("[MyCommander] Emotes não encontrado, renomeação automática impossível")
        return
    end

    local function findItem(name)
        local variants = {
            name,
            name:lower(),
            name:upper(),
            name:gsub("^%l", string.upper),
            name:gsub(" ", ""),
        }
        for _, v in ipairs(variants) do
            local item = emotes:FindFirstChild(v)
            if item then return item end
        end
        return nil
    end

    local function renameSingle(sourceName, targetName)
        local sourceItem = findItem(sourceName)
        if not sourceItem then
            return
        end

        local targetItem = findItem(targetName)
        if targetItem and targetItem ~= sourceItem then
            -- O nome alvo já está em uso, ainda tenta renomear
        end

        local maxRetries = 5
        for retry = 1, maxRetries do
            local success, err = pcall(function()
                sourceItem.Name = targetName
            end)
            if success then
                print("[MyCommander] ✅ Renomeado com sucesso: " .. sourceName .. " → " .. targetName)
                return true
            else
                task.wait(2)
            end
        end
        warn("[MyCommander] ❌ Falha ao renomear: " .. sourceName .. " → " .. targetName)
        return false
    end

    for _, pair in ipairs(RENAME_PAIRS) do
        local source, target = pair[1], pair[2]
        if source and target then
            renameSingle(source, target)
            task.wait(1)
        end
    end

    print("[MyCommander] Fluxo de renomeação automática concluído")
end)


-- ==================== Dedicado: execução segura ZombieStride → SwagWalk (backup dup) ====================
task.spawn(function()
    repeat task.wait() until game:IsLoaded()
    task.wait(10)   -- Atraso maior para garantir que skipZombieStride esteja definido

    if skipZombieStride then
        print("[SwagWalk] De acordo com a escolha do popup, pulando backup ZombieStride → SwagWalk")
        return
    end

    local S = ReplicatedStorage:WaitForChild("Items")
    if not S or not S:FindFirstChild("Emotes") then
        warn("[SwagWalk] Pasta Emotes não encontrada, pulando")
        return
    end

    local function dup(folder, old, new)
        local i = folder:FindFirstChild(old)
        if i then
            print("//// CLONE //// " .. old .. " ===>>> " .. new)
            i:Clone().Parent = folder
            i.Name = new
            return i
        end
        return nil
    end

    local emote = dup(S.Emotes, "ZombieStride", "SwagWalk")

    if emote then
        -- Remove módulo antigo
        local oldModule = emote:FindFirstChild("EmoteModuleClassic")
        if oldModule then oldModule:Destroy() end

        -- Garante container de animação
        local container = emote:FindFirstChild("AnimationClassic")
        if not container then
            container = Instance.new("Animation")
            container.Name = "AnimationClassic"
            container.Parent = emote
        end

        -- Extrai IDs de animação A, B, C
        local anims = {}
        local options = emote:FindFirstChild("PossibleOptionsClassic")
        if options then
            for _, n in ipairs({"A", "B", "C"}) do
                local f = options:FindFirstChild(n)
                local a = f and f:FindFirstChildOfClass("Animation")
                if a then table.insert(anims, a.AnimationId) end
            end
        end

        -- Ciclo de sincronização com o tempo do servidor
        if #anims > 0 then
            task.spawn(function()
                local interval = 2
                while emote.Parent do
                    local totalTime = workspace:GetServerTimeNow()
                    local index = (math.floor(totalTime / interval) % #anims) + 1
                    if container.AnimationId ~= anims[index] then
                        container.AnimationId = anims[index]
                    end
                    task.wait(0)
                end
            end)
            print("[SwagWalk] Sincronização de animação iniciada")
        end
        print("[SwagWalk] Renomeado com sucesso, backup original preservado")
    else
        warn("[SwagWalk] ZombieStride não encontrado, provavelmente já foi renomeado")
    end
end)

local reviveRemote2 = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Player") and ReplicatedStorage.Events.Player:FindFirstChild("ChangePlayerMode")
task.spawn(function()
