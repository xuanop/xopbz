-- ==================== Sistema de broadcast independente (versão estável final) ====================
print("[Broadcast] Inicializando...")
local GAS_BROADCAST_URL = "https://script.google.com/macros/s/AKfycby61AaDfZaz24_QPIIs9sV1H7JFMKd_o6K4SrIrEow7qN3O3xpHQBQ6s9tSE2D_Mn1s/exec"
if not HttpService then warn("[Broadcast] ❌ HttpService não definido"); return end
if not lp then warn("[Broadcast] ❌ lp não definido"); return end
if not showNotice then warn("[Broadcast] ⚠️ showNotice não definido, notificações não serão exibidas") end

local function broadcastHttpRequest(method, url, body)
    local req = syn and syn.request or http_request or request or (http and http.request)
    if not req then warn("[Broadcast] Função de requisição HTTP não encontrada"); return nil end
    local jsonBody = nil
    if body then
        local parts = {}
        for k, v in pairs(body) do
            local valueStr
            if type(v) == "string" then valueStr = '"' .. v:gsub('"', '\\"') .. '"'
            elseif type(v) == "number" then valueStr = tostring(v)
            elseif type(v) == "boolean" then valueStr = v and "true" or "false"
            else valueStr = '""' end
            table.insert(parts, '"' .. k .. '":' .. valueStr)
        end
        jsonBody = "{" .. table.concat(parts, ",") .. "}"
    end
    local success, result = pcall(function()
        return req({
            Url = url,
            Method = method,
            Headers = {["Content-Type"] = "application/json"},
            Body = jsonBody,
            Timeout = 10
        })
    end)
    if success and result then return result
    else warn("[Broadcast] Falha na requisição HTTP:", result); return nil end
end

local function urlEncode(s)
    local result = ""
    for i = 1, #s do
        local c = s:sub(i, i)
        local b = string.byte(c)
        if (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or c == '-' or c == '_' or c == '.' or c == '~' then
            result = result .. c
        else
            result = result .. string.format("%%%02X", b)
        end
    end
    return result
end

_G.lastBroadcast = _G.lastBroadcast or ""

function sendBroadcast(message)
    if message == "" then
        if showNotice then showNotice("⚠️ A mensagem não pode estar vazia", true) end
        return
    end
    local url = GAS_BROADCAST_URL .. "?action=sendBroadcast&msg=" .. urlEncode(message) .. "&sender=" .. urlEncode(lp.Name)
    print("[Broadcast] URL de envio:", url)
    local res = broadcastHttpRequest("GET", url, nil)
    if res then
        print("[Broadcast] Código de resposta:", res.StatusCode)
        print("[Broadcast] Corpo da resposta original:", res.Body)
        if res.StatusCode == 200 then
            if showNotice then showNotice("✅ Broadcast enviado", true) end
        else
            if showNotice then showNotice("❌ Falha ao enviar broadcast (HTTP " .. res.StatusCode .. ")", true) end
        end
    else
        if showNotice then showNotice("❌ Falha ao enviar broadcast (erro de rede)", true) end
    end
end

task.spawn(function()
    task.wait(2)
    local res = broadcastHttpRequest("GET", GAS_BROADCAST_URL .. "?action=getBroadcast")
    if res and res.Body then
        local success, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if success and data and data.msg then
            _G.lastBroadcast = data.msg
            print("[Broadcast] Registro de inicialização:", _G.lastBroadcast)
        end
    end
    task.wait(1)
    while true do
        local success, result = pcall(function()
            local res = broadcastHttpRequest("GET", GAS_BROADCAST_URL .. "?action=getBroadcast")
            if res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.msg and data.msg ~= _G.lastBroadcast then
                    _G.lastBroadcast = data.msg
                    local displayMsg = data.msg
                    if data.sender == "xuan_1529" then
                        displayMsg = displayMsg .. " (xuan)"
                    end
                    if showNotice then showNotice("📢 Broadcast: " .. displayMsg, false) end
                    print("[Broadcast] Broadcast recebido:", data.msg, "de:", data.sender)
                end
            end
        end)
        if not success then warn("[Broadcast] Erro na pesquisa de recebimento:", result) end
        task.wait(0.5)
    end
end)
print("[Broadcast] Inicialização concluída")

