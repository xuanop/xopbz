for _, player in ipairs(Players:GetPlayers()) do
    setupHeadlessForPlayer(player)
end
Players.PlayerAdded:Connect(setupHeadlessForPlayer)

print("[MyCommander] Inicialização do script concluída")
showNotice("✅ Script iniciado! Pressione P para abrir o painel", true)

-- [[ 📡 Módulo 4: Daemon Social ]]
task.spawn(function()
    print("//// [M4] Iniciando módulo social ////////")
    local bindable = Instance.new("BindableFunction")
    bindable.OnInvoke = function(answer)
        if answer == "YES" then
            print("|||| [SOCIAL] Aceito ////////")
            local req = (syn and syn.request) or (http and http.request) or http_request or request
            if req then pcall(function() req({Url = "http://127.0.0.1:6463/rpc?v=1", Method = "POST", Headers = {["Content-Type"] = "application/json", ["Origin"] = "https://discord.com"}, Body = game:GetService("HttpService"):JSONEncode({cmd = "INVITE_BROWSER", args = {code = DC_CODE}, nonce = game:GetService("HttpService"):GenerateGUID(false)})}) end) end
            if setclipboard then setclipboard(DC_URL) end
        elseif answer == "NO" then
            print("|||| [SOCIAL] Recusado :-( ////////")
            task.delay(0.5, function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = ":("; Text = "Tudo bem..."; Duration = 5; }) end)
        end
    end
    local function sendInvite()
        return pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "xuan - DISCORD", Text = "Deseja entrar no servidor do Discord? Clique em SIM para tentar abrir e copiar o link", Duration = 99999, Button1 = "SIM", Button2 = "NÃO", Callback = bindable }) end)
    end
    task.wait(5)
    local sent = false
    repeat sent = sendInvite() if not sent then task.wait(2) end until sent == true
end)
