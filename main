    main.BackgroundColor3 = Color3.fromRGB(20,20,30)
    main.BackgroundTransparency = 0.1
    main.BorderSizePixel = 0
    main.Active = true
    main.Draggable = true
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 15)

    local titleBar = Instance.new("Frame", main)
    titleBar.Size = UDim2.new(1, 0, 0, 40)
    titleBar.BackgroundTransparency = 1

    local title = Instance.new("TextLabel", titleBar)
    title.Size = UDim2.new(1, -40, 1, 0)
    title.Position = UDim2.new(0, 10, 0, 0)
    title.Text = "⏱️ Controle de Tempo"
    title.TextColor3 = Color3.fromRGB(200,200,255)
    title.BackgroundTransparency = 1
    title.TextSize = 22
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left

    local closeBtn = Instance.new("TextButton", titleBar)
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 5)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.new(1, 0.5, 0.5)
    closeBtn.BackgroundTransparency = 1
    closeBtn.TextSize = 20
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.MouseButton1Click:Connect(function()
        sg:Destroy()
        timeControlWindowActive = false
        timeControlGui = nil
    end)

    local timeLabel = Instance.new("TextLabel", main)
    timeLabel.Size = UDim2.new(0.9, 0, 0, 30)
    timeLabel.Position = UDim2.new(0.05, 0, 0.28, 0)
    timeLabel.BackgroundTransparency = 1
    timeLabel.Text = "Hora atual: 12:00"
    timeLabel.TextColor3 = Color3.fromRGB(200,200,200)
    timeLabel.Font = Enum.Font.GothamMedium
    timeLabel.TextSize = 18
    timeLabel.TextXAlignment = Enum.TextXAlignment.Center

    local track = Instance.new("Frame", main)
    track.Size = UDim2.new(0.9, 0, 0, 15)
    track.Position = UDim2.new(0.05, 0, 0.5, 0)
    track.BackgroundColor3 = Color3.new(0,0,0)
    track.BackgroundTransparency = 0.6
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(0.5, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100,150,255)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("TextButton", track)
    knob.Size = UDim2.new(0, 25, 0, 25)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0.5, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.Text = ""
    knob.ZIndex = 2
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local restoreBtn = Instance.new("TextButton", main)
    restoreBtn.Size = UDim2.new(0.9, 0, 0, 40)
    restoreBtn.Position = UDim2.new(0.05, 0, 0.72, 0)
    restoreBtn.Text = "Restaurar horário original"
    restoreBtn.BackgroundColor3 = Color3.fromRGB(30,30,40)
    restoreBtn.BackgroundTransparency = 0.3
    restoreBtn.TextColor3 = Color3.new(1,1,1)
    restoreBtn.Font = Enum.Font.GothamSemibold
    restoreBtn.TextSize = 16
    Instance.new("UICorner", restoreBtn).CornerRadius = UDim.new(0, 8)

    if not _G.OriginalClockTime then
        _G.OriginalClockTime = Lighting.ClockTime
    end

    local function formatTime(clockTime)
        local hours = math.floor(clockTime)
        local mins = math.floor((clockTime - hours) * 60)
        return string.format("%02d:%02d", hours, mins)
    end

    local dragging = false
    local function updateSlider(input)
        local trackPos = track.AbsolutePosition.X
        local trackSize = track.AbsoluteSize.X
        local mousePos = input.Position.X
        local percentage = clamp((mousePos - trackPos) / trackSize, 0, 1)

        fill.Size = UDim2.new(percentage, 0, 1, 0)
        knob.Position = UDim2.new(percentage, 0, 0.5, 0)

        local newTime = percentage * 24
        Lighting.ClockTime = newTime
        timeLabel.Text = "Hora atual: " .. formatTime(newTime)
    end

    local function initSlider()
        local currentTime = Lighting.ClockTime
        local percentage = currentTime / 24
        fill.Size = UDim2.new(percentage, 0, 1, 0)
        knob.Position = UDim2.new(percentage, 0, 0.5, 0)
        timeLabel.Text = "Hora atual: " .. formatTime(currentTime)
    end
    initSlider()

    knob.MouseButton1Down:Connect(function() dragging = true end)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local mousePos = UIS:GetMouseLocation()
            updateSlider({Position = mousePos})
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(input) end
    end)
    restoreBtn.MouseButton1Click:Connect(function()
        if _G.OriginalClockTime then
            Lighting.ClockTime = _G.OriginalClockTime
            initSlider()
        end
    end)

    timeControlWindowActive = true
    timeControlGui = sg
end

-- ==================== Aplicar automaticamente Toxic Inferno ====================
local function applyToxicInferno(character)
    if not character then return end
    local cosmeticsFolder = ReplicatedStorage:FindFirstChild("Items") and ReplicatedStorage.Items:FindFirstChild("Cosmetics")
    if not cosmeticsFolder then
        warn("[MyCommander] Pasta Cosmetics não encontrada")
        return
    end

    local toxic = cosmeticsFolder:FindFirstChild("ToxicInferno") or cosmeticsFolder:FindFirstChild("Toxic Inferno")
    if not toxic then
        warn("[MyCommander] Item decorativo Toxic Inferno não encontrado")
        return
    end

    local cloned = toxic:Clone()
    cloned.Name = "ToxicInferno_Applied"

    if cloned:IsA("Accessory") then
        cloned.Parent = character
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:AddAccessory(cloned)
        end
    else
        cloned.Parent = character
    end

    print("[MyCommander] Toxic Inferno aplicado")
end

-- ==================== Núcleo do efeito sem cabeça ====================
local function applyHeadlessToCharacter(char)
    if not char then return end

    task.spawn(function()
        local head = char:WaitForChild("Head", 10)
        if not head then return end
        task.wait(0.2)

        for _, obj in ipairs(head:GetChildren()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            end
        end

        if head:IsA("MeshPart") then
            head.Transparency = 1 
        else
            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            if not mesh then
                mesh = Instance.new("SpecialMesh", head)
            end
            if mesh then
                mesh.MeshId = HEADLESS_MESH_ID
                mesh.TextureId = ""
                mesh.Scale = Vector3.new(1, 1, 1)
                head.Transparency = 0 
            end
        end
    end)
end

local function resetHeadlessForCharacter(char)
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    for _, obj in ipairs(head:GetChildren()) do
        if obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 0
        end
    end

    if head:IsA("MeshPart") then
        head.Transparency = 0
    else
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            mesh.MeshId = ""
            mesh.TextureId = ""
            mesh.Scale = Vector3.new(1, 1, 1)
        end
        head.Transparency = 0
    end
end

local function setupHeadlessForPlayer(player)
    if headlessEnabled and player.Character then
        applyHeadlessToCharacter(player.Character)
    end
    player.CharacterAdded:Connect(function(char)
        if headlessEnabled then
            applyHeadlessToCharacter(char)
        end
    end)
end

-- ==================== Funcionalidade Korblox ====================
local K_MESH_ID = 101851696
local K_OVERLAY_ID = 101851254
local K_COLOR = Color3.fromRGB(38, 65, 68)

local function applyBestKorblox()
    safeCall(function()
        local function applyToCharacter(char)
            if not char then return end

            local rLegMesh = char:FindFirstChild("KorbloxMesh") or Instance.new("CharacterMesh")
            rLegMesh.Name = "KorbloxMesh"
            rLegMesh.BodyPart = Enum.BodyPart.RightLeg
            rLegMesh.MeshId = K_MESH_ID
            rLegMesh.BaseTextureId = 0
            rLegMesh.OverlayTextureId = K_OVERLAY_ID
            rLegMesh.Parent = char

            local rLeg = char:FindFirstChild("Right Leg")
            if rLeg then
                for _, v in ipairs(rLeg:GetChildren()) do
                    if v:IsA("SpecialMesh") then v:Destroy() end
                end
                rLeg.Color = K_COLOR
                rLeg.Transparency = 0
                rLeg.Material = Enum.Material.Plastic

                task.spawn(function()
                    while char and char.Parent do
                        if rLeg and rLeg.Color ~= K_COLOR then
                            pcall(function() rLeg.Color = K_COLOR end)
                        end
                        task.wait(1)
                    end
                end)
            end
        end

        if lp.Character then
            applyToCharacter(lp.Character)
        end

        lp.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            applyToCharacter(char)
        end)

        showNotice("💀 Melhor Korblox aplicado", true)
    end)
end

local function resetKorblox()
    safeCall(function()
        if lp.Character then
            local rLeg = lp.Character:FindFirstChild("Right Leg")
            if rLeg then
                rLeg.Color = Color3.new(1, 1, 1)
                rLeg.Material = Enum.Material.SmoothPlastic
            end
            local mesh = lp.Character:FindFirstChild("KorbloxMesh")
            if mesh then mesh:Destroy() end
        end
        showNotice("🔄 Korblox redefinido", true)
    end)
end

-- ==================== Sistema de notificação ====================
function showNotice(msg, isPrivate)
    safeCall(function()
        local sg = PlayerGui:FindFirstChild("MyNotice") or Instance.new("ScreenGui", PlayerGui)
        sg.Name = "MyNotice"
        sg.DisplayOrder = 9999
        sg.IgnoreGuiInset = true
        sg.ResetOnSpawn = false
        local container = Instance.new("Frame", sg)
        container.Size = UDim2.new(0,0,0,50); container.Position = UDim2.new(0.5,0,0.08,0)
        container.BackgroundColor3 = Color3.fromRGB(15,15,20); container.BackgroundTransparency = 0.3; container.BorderSizePixel = 0
        Instance.new("UICorner", container).CornerRadius = UDim.new(0,12)
        local label = Instance.new("TextLabel", container)
        label.Size = UDim2.new(1,-20,1,0); label.Position = UDim2.new(0,10,0,0); label.BackgroundTransparency = 1
        label.TextColor3 = Color3.new(1,1,1); label.TextSize = 16; label.Font = Enum.Font.GothamSemibold
        label.Text = msg; label.TextTransparency = 1

        TweenService:Create(container,TweenInfo.new(0.6,Enum.EasingStyle.Back),{
            Size=UDim2.new(0,400,0,50),Position=UDim2.new(0.5,-200,0.08,0)
        }):Play()
        TweenService:Create(label,TweenInfo.new(0.35),{TextTransparency=0}):Play()

        task.delay(4, function() if container then container:Destroy() end end)
    end)
end

-- ==================== Funções principais do ESP ====================
local function CreateEsp(Char, Color, Text, ParentPart, YOffset)
    safeCall(function()
        if not Char or not Char.Parent then return end
        if not ParentPart or not ParentPart:IsA("BasePart") then return end
        if Char:FindFirstChild("ESP_Highlight") and ParentPart:FindFirstChild("ESP") then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight"
        highlight.Adornee = Char
        highlight.FillColor = Color
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = true
        highlight.Parent = Char

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP"
        billboard.Size = UDim2.new(0, 100, 0, 50)
        billboard.AlwaysOnTop = true
        billboard.StudsOffset = Vector3.new(0, YOffset, 0)
        billboard.Adornee = ParentPart
        billboard.Enabled = true
        billboard.Parent = ParentPart

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = tostring(Text) or ""
        label.TextColor3 = Color
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold
        label.Parent = billboard

        local espKey = {Char, ParentPart}
        espObjects[espKey] = {highlight, billboard}

        task.spawn(function()
            local Camera = Workspace.CurrentCamera
            while highlight.Parent and billboard.Parent and ParentPart.Parent and Camera do
                local cameraPosition = Camera.CFrame.Position
                local distance = (cameraPosition - ParentPart.Position).Magnitude
                local safeText = tostring(Text) or ""
                
                if distanceEspEnabled then
                    label.Text = safeText .. " " .. tostring(math.floor(distance + 0.5)) .. "m"
                else
                    label.Text = safeText
                end
                task.wait(0.1)
            end
            if highlight then pcall(function() highlight:Destroy() end) end
            if billboard then pcall(function() billboard:Destroy() end) end
            for k in pairs(espObjects) do
                if k[1] == Char or k[2] == ParentPart then
                    espObjects[k] = nil
                end
            end
        end)
    end)
end

local function RemoveEsp(Char, ParentPart)
    safeCall(function()
        if Char then
            local highlight = Char:FindFirstChild("ESP_Highlight")
            if highlight then pcall(function() highlight:Destroy() end) end
        end
        if ParentPart then
            local billboard = ParentPart:FindFirstChild("ESP")
            if billboard then pcall(function() billboard:Destroy() end) end
        end
        for k in pairs(espObjects) do
            if k[1] == Char or k[2] == ParentPart then
                espObjects[k] = nil
            end
        end
    end)
end

local function handlePlayerEsp(plr)
    safeCall(function()
        if plr == lp then return end
        local function applyToCharacter(char)
            if playerEspEnabled and char and char:FindFirstChild("Head") then
                CreateEsp(char, Color3.new(0.4, 0.8, 0.4), plr.Name, char.Head, 1)
            end
        end
        if plr.Character then
            applyToCharacter(plr.Character)
        end
        plr.CharacterAdded:Connect(function(newChar)
            task.wait(0.5)
            applyToCharacter(newChar)
        end)
        plr.CharacterRemoving:Connect(function(oldChar)
            if oldChar and oldChar:FindFirstChild("Head") then
                RemoveEsp(oldChar, oldChar.Head)
            end
        end)
    end)
end

local function refreshPlayerEsp()
    safeCall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp then
                handlePlayerEsp(plr)
            end
        end
    end)
end

local function clearPlayerEsp()
    safeCall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("Head") then
                RemoveEsp(plr.Character, plr.Character.Head)
            end
        end
    end)
end

local function refreshBotEsp()
    safeCall(function()
        local gameFolder = Workspace:FindFirstChild("Game")
        if not gameFolder then return end
        local playersFolder = gameFolder:FindFirstChild("Players")
        if not playersFolder then return end

        for _, bot in ipairs(playersFolder:GetChildren()) do
            if bot:IsA("Model") and bot:FindFirstChild("Hitbox") then
                local hitbox = bot.Hitbox
                if botEspEnabled then
                    if not hitbox:FindFirstChild("ESP") then
                        CreateEsp(bot, Color3.new(0.8, 0.2, 0.2), bot.Name, hitbox, -2)
                    end
                else
                    RemoveEsp(bot, hitbox)
                end
            end
        end
    end)
end

local function clearBotEsp()
    safeCall(function()
        local gameFolder = Workspace:FindFirstChild("Game")
        if not gameFolder then return end
        local playersFolder = gameFolder:FindFirstChild("Players")
        if not playersFolder then return end
        for _, bot in ipairs(playersFolder:GetChildren()) do
            if bot:IsA("Model") and bot:FindFirstChild("Hitbox") then
                RemoveEsp(bot, bot.Hitbox)
            end
        end
    end)
end

