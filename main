function startSimpleRescue()
    if simpleRescueConnection then simpleRescueConnection:Disconnect() end
    simpleRescueEnabled = true
    print("[Resgate] Modo de resgate contínuo instantâneo iniciado (trava no alvo até resgatar)")

    local POST_TELEPORT_WAIT = 0.05
    local RETRY_INTERVAL = 0.15
    local POST_FIRE_WAIT = 0.12
    local MAX_RETRIES_PER_TARGET = 15

    if type(lastRescueTime) ~= "table" then lastRescueTime = {} end

    local interactRemote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Character") and ReplicatedStorage.Events.Character:FindFirstChild("Interact")
    if not interactRemote then
        warn("[Resgate] Evento remoto Interact não encontrado, resgate instantâneo indisponível")
        return
    end

    local lastLogTime = {}
    local activeTarget = nil
    local retryCount = 0
    local nextRetryTime = 0

    simpleRescueConnection = RunService.Heartbeat:Connect(function()
        if not simpleRescueEnabled or not autoRescueEnabled then return end

        -- Verificação do próprio estado
        if not lp.Character then return end
        local myHumanoid = lp.Character:FindFirstChild("Humanoid")
        if not myHumanoid or myHumanoid.Health <= 0 then return end
        local myState = lp.Character:GetAttribute("State") or ""
        local myDowned = lp.Character:GetAttribute("Downed")
        if myDowned or myState == "Downed" or myState == "Dead" then return end

        local myPos = lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character.HumanoidRootPart.Position
        if not myPos then return end

        local gameFolder = workspace:FindFirstChild("Game")
        local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")
        if not playersFolder then return end

        local now = os.clock()

        -- Verifica se o alvo ativo ainda é válido
        if activeTarget then
            local char = playersFolder:FindFirstChild(activeTarget.Name) or playersFolder:FindFirstChild(tostring(activeTarget.UserId))
            if char then
                local isDowned = char:GetAttribute("Downed") == true or (char:GetAttribute("State") == "Downed")
                if not isDowned then
                    activeTarget = nil
                    retryCount = 0
                    nextRetryTime = 0
                end
            else
                activeTarget = nil
                retryCount = 0
                nextRetryTime = 0
            end
        end

        -- Se não há alvo ativo, procura o jogador caído mais próximo
        if not activeTarget then
            local nearestPlayer = nil
            local nearestDist = math.huge
            local targetCharacter = nil

            for _, player in ipairs(Players:GetPlayers()) do
                if player == lp then continue end
                local char = playersFolder:FindFirstChild(player.Name) or playersFolder:FindFirstChild(tostring(player.UserId))
                if char then
                    local isDowned = char:GetAttribute("Downed") == true or (char:GetAttribute("State") == "Downed")
                    if isDowned then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local dist = (myPos - hrp.Position).Magnitude
                            if dist < nearestDist then
                                nearestDist = dist
                                nearestPlayer = player
                                targetCharacter = char
                            end
                        end
                    end
                end
            end

            if nearestPlayer then
                activeTarget = nearestPlayer
                retryCount = 0
                nextRetryTime = 0
                -- Opcional: descomente para depuração
                -- print("[Resgate Contínuo] Novo alvo travado:", activeTarget.Name, "distância:", nearestDist)
            else
                return
            end
        end

        -- Controle de frequência e tentativas
        if now < nextRetryTime then return end
        if retryCount >= MAX_RETRIES_PER_TARGET then
            if now - (lastLogTime[activeTarget.UserId .. "_giveup"] or 0) > 10 then
                showNotice("⚠️ Não foi possível resgatar " .. activeTarget.Name .. ", desistindo", true)
                lastLogTime[activeTarget.UserId .. "_giveup"] = now
            end
            activeTarget = nil
            retryCount = 0
            nextRetryTime = 0
            return
        end

        local targetChar = playersFolder:FindFirstChild(activeTarget.Name) or playersFolder:FindFirstChild(tostring(activeTarget.UserId))
        if not targetChar then
            activeTarget = nil
            retryCount = 0
            nextRetryTime = 0
            return
        end

        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetHRP or not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end

        -- Teletransporte
        lp.Character.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
        lp.Character.HumanoidRootPart.CFrame = CFrame.lookAt(lp.Character.HumanoidRootPart.Position, targetHRP.Position)
        task.wait(POST_TELEPORT_WAIT)

        local cleanName = activeTarget.Name:gsub("%s+", "")
        local success, err = pcall(function()
            interactRemote:FireServer("Revive", true, cleanName)
        end)

        if success then
            task.wait(POST_FIRE_WAIT)
            local freshChar = playersFolder:FindFirstChild(activeTarget.Name) or playersFolder:FindFirstChild(tostring(activeTarget.UserId))
            if freshChar then
                local stillDowned = freshChar:GetAttribute("Downed") == true or (freshChar:GetAttribute("State") == "Downed")
                if not stillDowned then
                    -- Resgate bem-sucedido, exibe apenas a mensagem final de sucesso
                    print("[Resgate Contínuo] ✅ Resgatou " .. activeTarget.Name .. " com sucesso")
                    showNotice("⚡ Resgate instantâneo de " .. activeTarget.Name, true)
                    activeTarget = nil
                    retryCount = 0
                    nextRetryTime = 0
                    
                    -- ========== NOVO: após resgate bem-sucedido, se farm aéreo estiver ativo, retorna à plataforma alta ==========
                    if autoFarmEnabled then
                        task.spawn(function()
                            -- Teletransporta para as coordenadas do farm aéreo
                            targetHRP = nil  -- evita conflito de variável, obtém novamente o HRP do jogador local
                            if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                                local hrp = lp.Character.HumanoidRootPart
                                local targetPos = Vector3.new(SKY_X, SKY_Y, SKY_Z)
                                hrp.CFrame = CFrame.new(targetPos)
                                task.wait(0.1)
                                -- Garante que a plataforma exista e acompanhe
                                if not skyPlatform or not skyPlatform.Parent then
                                    skyPlatform = createSkyPlatform()
                                else
                                    local newPos = hrp.Position - Vector3.new(0, 2.5, 0)
                                    skyPlatform.Position = newPos
                                end
                                print("[Resgate] Retornou ao ponto de farm aéreo")
                            end
                        end)
                    end
                    -- ================================================================
                    
                    return
                end
            end
        else
            warn("[Resgate Contínuo] Erro no FireServer: " .. tostring(err))
        end

        -- Falha nesta rodada, incrementa tentativas e define próximo momento de nova tentativa
        retryCount = retryCount + 1
        nextRetryTime = now + RETRY_INTERVAL
    end)
    print("[Resgate] Monitoramento de resgate contínuo iniciado (trava no alvo até resgatar)")
end

function stopSimpleRescue()
    simpleRescueEnabled = false
    if simpleRescueConnection then
        simpleRescueConnection:Disconnect()
        simpleRescueConnection = nil
        lastRescueTime = {}
        print("[Resgate] Monitoramento interrompido")
    end
end

-- ==================== Correção forçada para sobrescrever erros de scripts externos ====================
task.spawn(function()
    task.wait(5)
    toggleAutoRescue = function()
        autoRescueEnabled = not autoRescueEnabled
        autoReviveEnabled = autoRescueEnabled
        print("[Auto Resgate] Estado alterado para:", autoRescueEnabled and "ativado" or "desativado")
        if autoRescueEnabled then
            startSimpleRescue()
            showNotice("✅ Auto resgate ativado", true)
        else
            stopSimpleRescue()
            showNotice("❌ Auto resgate desativado", true)
        end
    end
    updateAntiAFK()
    refreshPanelButtons()
    print("[Script Principal] toggleAutoRescue sobrescrito com sucesso")
end)

