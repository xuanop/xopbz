local function IsFieldClean()
    local gameFolder = workspace:FindFirstChild("Game")
    local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")
    if not playersFolder then return false end
    for _, entity in pairs(playersFolder:GetChildren()) do
        if not Players:GetPlayerFromCharacter(entity) then
            return false
        end
    end
    return true
end

local function IsTrulyVisible(element)
    if not element or not element.Visible then return false end
    local current = element.Parent
    while current do
        if current:IsA("ScreenGui") then return current.Enabled end
        if current:IsA("GuiObject") and not current.Visible then return false end
        current = current.Parent
    end
    return true
end

task.spawn(function()
    while true do
        if IsFieldClean() then
            local foundTimer = false
            for _, name in pairs({"IntermissionTimer", "RoundTimer"}) do
                for _, element in pairs(PlayerGui:GetDescendants()) do
                    if element.Name == name and element:IsA("GuiObject") and IsTrulyVisible(element) then
                        foundTimer = true
                        break
                    end
                end
                if foundTimer then break end
            end
            if foundTimer then
                task.wait(0.1)
                if IsFieldClean() then
                    pcall(function()
                        ReplicatedStorage.Events.Admin.VIPCommand:InvokeServer("!time 1")
                    end)
                    task.wait(2.5)
                end
            else
                task.wait(0.5)
            end
        else
            task.wait(1)
        end
    end
end)

